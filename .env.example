# Salin file ini menjadi .env dan isi nilai yang kuat.
APP_BIND=0.0.0.0
APP_PORT=8300
PORT=3000
DATA_DIR=/data

# Buat secret acak:
# openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
APP_ENCRYPTION_KEY=GANTI_DENGAN_OUTPUT_OPENSSL_RAND_HEX_32_64_KARAKTER

# Admin awal hanya dibuat jika database belum memiliki user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MINIMAL_12_KARAKTER

# Nama address-list yang dikelola aplikasi. Firewall filter rule harus dibuat manual.
MIKROTIK_ISOLATION_LIST=USER_MANAGER_ISOLATED
TOKEN_TTL=12h
